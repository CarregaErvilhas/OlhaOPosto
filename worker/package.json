{
  "name": "olhaoposto-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "vendor": "node scripts/vendor.ts",
    "predev": "npm run vendor",
    "dev": "wrangler dev",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "db:local": "wrangler d1 migrations apply DB --local",
    "import:local": "node scripts/import-stations.ts --local",
    "remote": "node scripts/remote.ts",
    "deploy": "node scripts/deploy.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "@mediapipe/tasks-vision": "1.2.3",
    "@types/node": "24.19.2",
    "leaflet": "1.9.4",
    "libheif-js": "1.23.5",
    "typescript": "7.0.2",
    "wrangler": "4.160.1"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.33.0",
    "zod": "4.6.7"
  }
}
