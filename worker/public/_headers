# Font files are never edited in place: a new version gets a new file name.
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable
# CSS and JS keep their names, so the browser revalidates them (ETag) on every
# page: a deploy must never pair new HTML with yesterday's stylesheet.
/site.css
  Cache-Control: public, no-cache
/site.js
  Cache-Control: public, no-cache
/theme.js
  Cache-Control: public, no-cache
# Both are UTF-8 (llms.txt has the ŧ of the brand); say so, or a browser may guess.
/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8
/llms.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8
