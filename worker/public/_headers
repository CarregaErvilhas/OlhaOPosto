# Font files are never edited in place: a new version gets a new file name.
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable
# CSS and JS keep their names, so the browser revalidates them (ETag) on every
# page: a deploy must never pair new HTML with yesterday's stylesheet.
/site.css
  Cache-Control: public, no-cache
/site.js
  Cache-Control: public, no-cache
/theme.js
  Cache-Control: public, no-cache
# Both are UTF-8 (llms.txt has the ŧ of the brand); say so, or a browser may guess.
/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8
/llms.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8
/upload.js
  Cache-Control: public, no-cache
/jpeg.js
  Cache-Control: public, no-cache
/heic.js
  Cache-Control: public, no-cache
/heif.js
  Cache-Control: public, no-cache
/detect.js
  Cache-Control: public, no-cache
# Libraries copied from node_modules at deploy (scripts/vendor.ts): same names
# across versions, so revalidate. The wasm files are large; a 304 is cheap.
/vendor/*
  Cache-Control: public, no-cache
# The face model never changes in place: a new model gets a new name.
/models/*.tflite
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream
# The group page's mascots: each site's own art, which may change with a deploy.
/grupo/*
  Cache-Control: public, max-age=86400
