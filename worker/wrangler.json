{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pictures",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "voltframe.ocarroeletrico.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pictures",
      "database_id": "local-only",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
