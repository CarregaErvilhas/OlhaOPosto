{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "olhaoposto",
  "main": "src/index.ts",
  "assets": {
    "directory": "./public"
  },
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "olhaoposto.ocarroeletrico.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pictures",
      "database_id": "local-only",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "STAGING",
      "bucket_name": "pictures-staging"
    },
    {
      "binding": "PICTURES",
      "bucket_name": "pictures"
    }
  ],
  "ratelimits": [
    {
      "name": "UPLOAD_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "SEARCH_LIMIT",
      "namespace_id": "1003",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "TAKEDOWN_LIMIT",
      "namespace_id": "1004",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
